#!/usr/bin/python3
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parent))
from interactive import wrapper, record_wrapper_failure
try:
    wrapper(sys.argv[1:])
except Exception as e:
    record_wrapper_failure(e)
    print('DSP7 interactive wrapper: '+str(e),file=sys.stderr)
    sys.exit(2)
